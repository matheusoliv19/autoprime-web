{
  "env": {
    "browser": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error",
    "eqeqeq": "error",
    "no-eval": "error",
    "no-console": "warn",
    "semi": ["error", "always"],
    "no-var": "error",
    "prefer-const": "warn"
  }
}
